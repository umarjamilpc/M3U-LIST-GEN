SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Persistent storage (users, settings, playlists, uploads, generated M3U).
# Leave empty to use ./data next to the app. Use an absolute path for servers.
# Windows example: DATA_DIR=E:\CURSOR\M3U-LIST-GEN\data
# Docker: set to /data and mount a volume there.
DATA_DIR=
# Leave empty to auto-detect from each request (recommended with Nginx Proxy Manager:
# local http://IP:3000 and https://your-domain both get correct playlist URLs).
# Optional override if you must force one public origin:
PUBLIC_BASE_URL=
PORT=3000
